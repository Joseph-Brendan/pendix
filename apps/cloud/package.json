{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pendix/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@pendix/shared": "workspace:*",
    "@sentry/node": "^9.47.1",
    "better-auth": "^1.3.27",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pino": "^9.9.5",
    "postgres": "^3.4.7",
    "resend": "^6.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
