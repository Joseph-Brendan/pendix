exports[`grading worker, retries/refunds, and React Email reports > matches the HTML snapshot for the branded React Email session report 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="background-color:#F6F5F2;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Pendix report for pendix-shop: prompt score 7.4/10, understanding 8/10<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#F6F5F2;color:#0A0A0A;font-family:&quot;Inter&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;margin:0;padding:32px 16px"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;background-color:#FFFFFF;border:1px solid #E4E2DD;border-radius:10px;margin:0 auto;padding:28px 28px 32px"><tbody><tr style="width:100%"><td><p style="font-size:16px;line-height:24px;margin:0 0 20px;font-weight:700;color:#0A0A0A;letter-spacing:-0.01em;margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0"><span style="color:#FF5A1F">●</span> pendix</p><h1 style="margin:0 0 6px;font-size:22px;line-height:28px;font-weight:700;color:#0A0A0A">pendix-shop</h1><p style="font-size:13px;line-height:24px;margin:0 0 20px;color:#6B6862;margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0">Session report for <!-- -->Ada Learner<!-- --> on <!-- -->2026-11-26</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#F6F5F2;border:1px solid #E4E2DD;border-radius:10px;padding:16px 18px;margin-bottom:22px"><tbody><tr><td><p style="font-size:14px;line-height:24px;margin:0 0 6px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0"><strong>Prompt score:</strong> <!-- -->7.4/10</p><p style="font-size:14px;line-height:24px;margin:0 0 6px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0"><strong>Understanding score:</strong> <!-- -->8/10</p><p style="font-size:13px;line-height:24px;margin:0;color:#6B6862;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Explained password hashing clearly and verified changes with tests.</p></td></tr></tbody></table><h2 style="margin:0 0 10px;font-size:16px;font-weight:700;color:#0A0A0A">Session notes</h2><p style="font-size:14px;line-height:21px;margin:0 0 12px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0"><strong>What was built:</strong> <!-- -->Added signup validation, password hashing, and Vitest auth tests in pendix-shop.</p><p style="font-size:14px;line-height:24px;margin:0 0 6px;font-weight:600;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">Three things learned</p><p style="font-size:14px;line-height:20px;margin:0 0 4px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">1<!-- -->. <!-- -->Validate inputs on the server with Zod.</p><p style="font-size:14px;line-height:20px;margin:0 0 4px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">2<!-- -->. <!-- -->Store only hashed passwords using argon2.</p><p style="font-size:14px;line-height:20px;margin:0 0 4px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">3<!-- -->. <!-- -->Write focused Vitest cases for error paths.</p><p style="font-size:14px;line-height:24px;margin:12px 0 6px;font-weight:600;color:#0A0A0A;margin-top:12px;margin-right:0;margin-bottom:6px;margin-left:0">Two things to work on</p><p style="font-size:14px;line-height:20px;margin:0 0 4px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">1<!-- -->. <!-- -->Name exact files in your first prompt.</p><p style="font-size:14px;line-height:20px;margin:0 0 4px;color:#0A0A0A;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">2<!-- -->. <!-- -->Include a concrete test command for every edit.</p><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#E4E2DD;margin:22px 0"/><h2 style="margin:0 0 12px;font-size:16px;font-weight:700;color:#0A0A0A">Prompts to improve</h2><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border:1px solid #E4E2DD;border-radius:10px;padding:14px 16px;margin-bottom:12px"><tbody><tr><td><p style="font-size:12px;line-height:24px;margin:0 0 6px;color:#6B6862;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">Prompt #<!-- -->1<!-- --> (score <!-- -->5<!-- -->/10)</p><p style="font-size:13px;line-height:24px;margin:0 0 8px;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &quot;Liberation Mono&quot;, monospace;color:#1C1C1C;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">fix login</p><p style="font-size:13px;line-height:24px;margin:0 0 6px;color:#6B6862;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0"><strong>Why:</strong> <!-- -->Goal is vague without naming the login bug. Missing exact file path and stack context.</p><p style="font-size:13px;line-height:24px;margin:0;color:#0A0A0A;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0"><strong>Stronger version:</strong> <!-- -->Update POST /login in src/routes/auth.ts to verify password hash and return 401 on mismatch.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border:1px solid #E4E2DD;border-radius:10px;padding:14px 16px;margin-bottom:12px"><tbody><tr><td><p style="font-size:12px;line-height:24px;margin:0 0 6px;color:#6B6862;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">Prompt #<!-- -->2<!-- --> (score <!-- -->6<!-- -->/10)</p><p style="font-size:13px;line-height:24px;margin:0 0 8px;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &quot;Liberation Mono&quot;, monospace;color:#1C1C1C;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">add button to header</p><p style="font-size:13px;line-height:24px;margin:0 0 6px;color:#6B6862;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0"><strong>Why:</strong> <!-- -->Missing exact file path and stack context. No concrete check or test command given.</p><p style="font-size:13px;line-height:24px;margin:0;color:#0A0A0A;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0"><strong>Stronger version:</strong> <!-- -->Add a Sign out button to src/components/Header.tsx using the secondary style and test click.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:24px;text-align:left"><tbody><tr><td><a href="https://app.pendix.dev/sessions/ses_snapshot_1" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#FF5A1F;color:#FFFFFF;font-size:14px;font-weight:600;padding:12px 20px;border-radius:10px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px" target="_blank"><span><!--[if mso]><i style="mso-font-width:500%;mso-text-raise:18" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">See full report</span><span><!--[if mso]><i style="mso-font-width:500%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:12px;line-height:24px;margin:20px 0 0;color:#6B6862;margin-top:20px;margin-right:0;margin-bottom:0;margin-left:0">You can turn off session report emails anytime in your Pendix dashboard settings.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;
