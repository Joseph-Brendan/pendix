# Database
DATABASE_URL=postgres://pendix:pendix@127.0.0.1:5433/pendix
TEST_DATABASE_URL=postgres://pendix:pendix@127.0.0.1:5434/pendix_test

# Runtime
NODE_ENV=development
PORT=3001
API_URL=http://127.0.0.1:3001
WEB_URL=http://127.0.0.1:5173

# Auth
AUTH_SECRET=replace-with-32-byte-random-hex
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@pendix.dev

# Payments (Flutterwave)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=

# Grading models & providers
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
PENDIX_GRADER_CREDIT_PRIMARY=
PENDIX_GRADER_CREDIT_FALLBACK=
PENDIX_GRADER_SUBSCRIBER_PRIMARY=
PENDIX_GRADER_SUBSCRIBER_FALLBACK=

# Private object storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payout encryption
PAYOUT_ENCRYPTION_KEY=replace-with-32-byte-random-hex

# Observability (Sentry - disabled when empty)
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# Rate limits
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=200
RATE_LIMIT_USER_WINDOW_MS=60000

# Regional pricing overrides (JSON)
NGN_PRICES_JSON=
